<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.july.lab.lp3-stage1</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO__/lp3/lab/run_lab.sh</string><string>stage1</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>20</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/.local/state/automation-lab/logs/lp3-stage1.launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/automation-lab/logs/lp3-stage1.launchd.log</string>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
